{
  "name": "md-to-whatsapp",
  "version": "0.2.0",
  "description": "Convert Markdown formatting to WhatsApp message formatting",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "napi": {
    "name": "md-to-whatsapp",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-apple-darwin",
        "aarch64-linux-android",
        "aarch64-unknown-linux-gnu",
        "aarch64-unknown-linux-musl",
        "armv7-unknown-linux-gnueabihf",
        "x86_64-unknown-linux-musl",
        "x86_64-unknown-freebsd",
        "i686-pc-windows-msvc"
      ]
    }
  },
  "bin": {
    "md-to-whatsapp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "*.node"
  ],
  "scripts": {
    "build": "pnpm build:native && tsup",
    "build:native": "napi build --platform --release --cargo-cwd native",
    "build:ts": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cd native && cargo test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "cspell": "cspell \"**/*.{ts,js,json,md}\"",
    "prepublishOnly": "napi prepublish -t npm"
  },
  "keywords": [
    "markdown",
    "whatsapp",
    "converter",
    "formatting",
    "rust",
    "napi"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "@types/node": "^25.0.3",
    "cspell": "^9.4.0",
    "eslint": "^9.39.2",
    "eslint-config-agent": "^1.8.9",
    "eslint-import-resolver-typescript": "^4.4.4",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
